# BloodBridge Flutter app — build-time configuration
#
# Values are passed with --dart-define (or --dart-define-from-file, see
# config/dev.json.example). Nothing here is read at runtime from a file.
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080
#   flutter run --dart-define-from-file=config/dev.json

# Base URL of the FastAPI backend. Defaults to the Android emulator's alias
# for the host machine. Use your LAN IP for a physical device, e.g.
# http://192.168.1.20:8000, and https://api.example.com in production.
API_BASE_URL=http://10.0.2.2:8080

# dev | staging | prod — only affects logging.
APP_ENV=dev

# OpenStreetMap tiles. The public server is fine for a pilot; use your own
# tile host (or a provider URL with your key) before scaling, per OSM policy.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim geocoder (search + reverse). Self-host or use a paid mirror at scale.
NOMINATIM_URL=https://nominatim.openstreetmap.org
